<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- 左侧视频区域 -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="8dp">

        <!-- 第一个视频窗口 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/darker_gray">

            <TextureView
                android:id="@+id/videoViewA"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 信号图标 -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="6dp"
                android:src="@drawable/icon_discovery"
                android:layout_gravity="top|left" />

            <!-- 身份标签 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="投保人"
                android:textColor="#FFFFFF"
                android:background="#28C4A6"
                android:padding="4dp"
                android:textSize="12sp"
                android:layout_gravity="top|right"
                android:layout_margin="6dp" />

            <!-- 卡通头像（你可换成 ImageView） -->
            <ImageView
                android:id="@+id/avatarA"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/actor" />

        </FrameLayout>

        <!-- 第二个视频窗口 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:background="@android:color/darker_gray">

            <TextureView
                android:id="@+id/videoViewB"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="6dp"
                android:src="@drawable/icon_discovery"
                android:layout_gravity="top|left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="销售人员"
                android:textColor="#FFFFFF"
                android:background="#FF6E2F"
                android:padding="4dp"
                android:textSize="12sp"
                android:layout_gravity="top|right"
                android:layout_margin="6dp" />

            <ImageView
                android:id="@+id/avatarB"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/actor" />
        </FrameLayout>

        <!-- 底部 LOGO -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:src="@drawable/ic_tl_logo"
            android:scaleType="fitCenter"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- 右侧提示区域 -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/leftPanel"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/icon_discovery" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="温馨提示"
            android:textSize="20sp"
            android:layout_marginTop="16dp"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="双录过程中请不要轻易退出，一旦退出需重新录制"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
